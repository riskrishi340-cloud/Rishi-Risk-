    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.33.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.546.0",
    "moment": "^2.29.4",
    "mongoose": "^7.0.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.6.1",
    "stripe": "^12.0.0",
    "twilio": "^3.77.0",
    "vite": "^6.2.3"
