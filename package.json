{
  "name": "vizon-hotel",
  "version": "1.0.0",
  "description": "Advanced AI Food Delivery Website & App - VIZON Hotel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
